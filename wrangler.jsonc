{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealmatch",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "client/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "mealmatch-local", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "cloudflare/migrations"}],
  "env": {
    "staging": {
      "name": "mealmatch-staging",
      "account_id": "00000000000000000000000000000000",
      "workers_dev": true,
      "preview_urls": false,
      "limits": {"cpu_ms": 1000},
      "assets": {"directory": "client/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"]},
      "d1_databases": [{"binding": "DB", "database_name": "mealmatch-staging", "database_id": "00000000-0000-0000-0000-000000000003", "migrations_dir": "cloudflare/migrations"}]
    },
    "production": {
      "name": "mealmatch-production",
      "account_id": "00000000000000000000000000000000",
      "workers_dev": true,
      "preview_urls": false,
      "limits": {"cpu_ms": 1000},
      "assets": {"directory": "client/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"]},
      "d1_databases": [{"binding": "DB", "database_name": "mealmatch-production", "database_id": "00000000-0000-0000-0000-000000000004", "migrations_dir": "cloudflare/migrations"}]
    }
  }
}
