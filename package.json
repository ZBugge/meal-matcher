{
  "name": "mealmatch",
  "version": "1.0.0",
  "description": "Collaborative meal decision app with swipe interface",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "audit:adversarial": "node scripts/audit-adversarial.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/worker-build.mjs",
    "start": "node scripts/worker-local.mjs --port 5173 --state .wrangler/dev",
    "test": "node scripts/test.mjs",
    "test:server": "node scripts/test.mjs --server",
    "test:client": "node scripts/test.mjs --client",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "migration:inventory": "node migration/inventory.mjs",
    "migration:preflight": "node migration/preflight.mjs",
    "migration:rehearse": "node migration/d1-rehearsal.mjs",
    "restore:rehearse": "node migration/full-backup.mjs",
    "migration:restore:legacy": "node migration/d1-rehearsal.mjs",
    "backup": "node migration/remote-backup.mjs",
    "backup:local": "node migration/full-backup.mjs",
    "deploy:staging": "node scripts/release.mjs --env staging",
    "deploy:production": "node scripts/release.mjs --env production",
    "smoke": "node scripts/smoke.mjs",
    "lint": "cd client && npm run lint",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^8.2.2",
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  }
}
